# ─────────────────────────────────────────────────────────────────────────────
# .env.example — copy this file to .env and fill in your real values
# NEVER commit .env to version control
# ─────────────────────────────────────────────────────────────────────────────

# ─── MCP Server ───────────────────────────────────────────────────────────────
# Required: API key for the FastAPI MCP server
# Generate a strong random key, e.g.: python -c "import secrets; print(secrets.token_hex(32))"
MCP_API_KEY=your_strong_random_key_here

# ─── Gmail OAuth ──────────────────────────────────────────────────────────────
# Path to the credentials.json downloaded from Google Cloud Console
GMAIL_CREDENTIALS_PATH=credentials.json

# Path where the OAuth token will be saved after first login
GMAIL_TOKEN_PATH=token.json

# ─── Telegram Bot ─────────────────────────────────────────────────────────────
# Get your bot token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# ─── LinkedIn Post Generation (choose one) ────────────────────────────────────
# Gemini Flash (free tier): https://aistudio.google.com
GEMINI_API_KEY=your_gemini_api_key_here

# Groq Llama 3.3 (free tier): https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# ─── Paths (optional — defaults shown) ───────────────────────────────────────
INBOX_PATH=vault/AI_Employee_Vault/Inbox/email
PROCESSED_EMAILS_PATH=processed_emails.json

# ─── Intervals (optional — defaults shown) ───────────────────────────────────
# How often Gmail watcher polls for new emails (seconds)
GMAIL_CHECK_INTERVAL=30

# How often task processor scans for new tasks (seconds)
TASK_PROCESSOR_INTERVAL=20

# ─── MCP Server Port (optional — default shown) ───────────────────────────────
MCP_PORT=8001

# ─── Testing / Safe Mode ──────────────────────────────────────────────────────
# Set to true to skip actual email sending (logs intent only — no real emails sent)
DRY_RUN=false

# ─── Facebook & Instagram (Meta Graph API) ────────────────────────────────────
# Generate a long-lived Page Access Token at developers.facebook.com
META_PAGE_ACCESS_TOKEN=your_long_lived_page_access_token
# Numeric Facebook Page ID (from GET /me/accounts)
META_PAGE_ID=your_numeric_page_id
# Instagram Business/Creator User ID linked to your Facebook Page
# (from GET /{page-id}?fields=instagram_business_account)
META_IG_USER_ID=your_instagram_business_user_id
# Graph API version (latest stable)
META_GRAPH_API_VERSION=v21.0

# ─── Odoo MCP Server ──────────────────────────────────────────────────────────
# Odoo Community self-hosted on port 8069
# ODOO_USERNAME/ODOO_PASSWORD = Odoo web login credentials (not PostgreSQL)
ODOO_URL=http://localhost:8069
ODOO_DB=odoo
ODOO_USERNAME=admin
ODOO_PASSWORD=admin
# json-rpc for Odoo 14–18; json-2 for Odoo 19+
ODOO_API_VERSION=json-rpc
