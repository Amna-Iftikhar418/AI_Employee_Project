# ─────────────────────────────────────────────────────────────────────────────
# .env.example — copy this file to .env and fill in your real values
# NEVER commit .env to version control
# ─────────────────────────────────────────────────────────────────────────────

# ─── MCP Server ───────────────────────────────────────────────────────────────
# Required: API key for the FastAPI MCP server
# Generate a strong random key, e.g.: python -c "import secrets; print(secrets.token_hex(32))"
MCP_API_KEY=your_strong_random_key_here

# ─── Gmail OAuth ──────────────────────────────────────────────────────────────
# Path to the credentials.json downloaded from Google Cloud Console
GMAIL_CREDENTIALS_PATH=credentials.json

# Path where the OAuth token will be saved after first login
GMAIL_TOKEN_PATH=token.json

# ─── Paths (optional — defaults shown) ───────────────────────────────────────
INBOX_PATH=vault/AI_Employee_Vault/Inbox
PROCESSED_EMAILS_PATH=processed_emails.json

# ─── Intervals (optional — defaults shown) ───────────────────────────────────
# How often Gmail watcher polls for new emails (seconds)
GMAIL_CHECK_INTERVAL=30

# How often task processor scans for new tasks (seconds)
TASK_PROCESSOR_INTERVAL=20
