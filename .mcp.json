{
  "mcpServers": {
    "browser": {
      "type": "stdio",
      "command": "uv",
      "args": [
        "--directory",
        "mcp_servers/browser_mcp",
        "run",
        "browser-mcp"
      ],
      "env": {
        "BROWSER_HEADLESS": "true",
        "BROWSER_TIMEOUT": "30000"
      }
    },
    "social": {
      "type": "stdio",
      "command": "uv",
      "args": [
        "--directory",
        "mcp_servers/social_mcp",
        "run",
        "social-mcp"
      ],
      "env": {
        "META_PAGE_ACCESS_TOKEN": "${META_PAGE_ACCESS_TOKEN}",
        "META_PAGE_ID": "${META_PAGE_ID}",
        "META_IG_USER_ID": "${META_IG_USER_ID}",
        "META_GRAPH_API_VERSION": "v21.0"
      }
    },
    "playwright": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "@playwright/mcp@latest",
        "--user-data-dir",
        "${USERPROFILE}/.playwright-profiles/ai-employee"
      ]
    },
    "odoo": {
      "type": "stdio",
      "command": "uv",
      "args": [
        "--directory",
        "mcp_servers/odoo_mcp",
        "run",
        "odoo-mcp"
      ],
      "env": {
        "ODOO_URL": "${ODOO_URL}",
        "ODOO_DB": "${ODOO_DB}",
        "ODOO_USERNAME": "${ODOO_USERNAME}",
        "ODOO_PASSWORD": "${ODOO_PASSWORD}",
        "ODOO_API_VERSION": "json-rpc"
      }
    }
  }
}
